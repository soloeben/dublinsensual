# Copy to .env.deploy and fill in. .env.deploy is gitignored — never commit it.

# "ftp"  FTPS (explicit AUTH TLS) via lftp — this is what the dsf-deploy
#        account on Sered uses. It is jailed to the dublinsensual.com
#        document root, so DEPLOY_REMOTE_PATH is just "/".
# "ssh"  rsync over SSH — currently unused; the SSH key for this project
#        was deauthorized in cPanel in favor of the scoped FTP account.
DEPLOY_METHOD=ftp

DEPLOY_HOST=host.cpse52.eu
DEPLOY_USER=dsf-deploy@dublinsensual.com
# The FTP account is chrooted to its own document root, so this is "/",
# not "/home/remotein/dublinsensual.com" or "/public_html/".
DEPLOY_REMOTE_PATH=/

# ftp: 21 (explicit FTPS)
# ssh: Sered's cPanel SSH port, if re-enabled (often 22, sometimes 2222)
DEPLOY_PORT=21

# ftp only. Leave empty when DEPLOY_METHOD=ssh.
DEPLOY_PASS=

# ssh only: path to the private key for this host.
DEPLOY_SSH_KEY=~/.ssh/sered_dsf

# true = remove remote files that no longer exist locally (destructive).
# Leave false until a --dry-run shows you only expected deletions.
DEPLOY_DELETE=false
