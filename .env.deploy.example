# Copy to .env.deploy and fill in. .env.deploy is gitignored — never commit it.

# "ssh" (preferred: rsync over SSH, key-based, no password stored)
# "ftp" (fallback if your Sered plan has no SSH: FTPS via lftp)
DEPLOY_METHOD=ssh

DEPLOY_HOST=host.cpse52.eu
DEPLOY_USER=
DEPLOY_REMOTE_PATH=/public_html/

# ssh: Sered's cPanel SSH port (often 22, sometimes 2222 — check cPanel > SSH Access)
# ftp: 21
DEPLOY_PORT=22

# ftp only. Leave empty when DEPLOY_METHOD=ssh.
DEPLOY_PASS=

# true = remove remote files that no longer exist locally (destructive).
# Leave false until a --dry-run shows you only expected deletions.
DEPLOY_DELETE=false
